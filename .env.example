# DawaLens Backend Configuration Template
# Copy this file to .env and configure your local or production settings.

# Environment
APP_ENV=development
DEBUG=True
HOST=0.0.0.0
PORT=8000

# CORS - Allowed Frontend Origins
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Database Configuration
# Default is SQLite for local development; use PostgreSQL for production:
# postgresql://postgres:password@localhost:5432/dawalens
DATABASE_URL=sqlite:///./dawalens.db

# Gemma 4 & Vision AI Service Configuration
# AI_PROVIDER options:
# - "gemma_4" (Google GenAI / Vertex AI with Gemma 4 or PaliGemma multimodal weights)
# - "huggingface" (HuggingFace Inference API for Gemma / PaliGemma vision models)
# - "ollama" (Local Ollama multimodal endpoint e.g. http://localhost:11434)
# - "test" (Deterministic test harness for unit testing and offline development)
AI_PROVIDER=gemma_4

# Gemma 4 Model Identifier (Configurable; do not hardcode invented model IDs)
# Recommended verified models:
# - google/paligemma-3b-pt-224 (Official open vision-language model)
# - google/paligemma2-3b-pt-224 (PaliGemma 2 multimodal)
# - gemma-4-vision-preview (When provisioned on enterprise Vertex AI)
GEMMA_MODEL_ID=google/paligemma2-3b-pt-224

# API Keys and Endpoints (Leave blank for offline / test mode)
GEMMA_API_KEY=
GEMMA_API_ENDPOINT=https://api-inference.huggingface.co/models/google/paligemma2-3b-pt-224

# Upload & Image Processing Safeguards
MAX_UPLOAD_SIZE_MB=15
MAX_IMAGE_COUNT_PER_SCAN=5
ALLOWED_IMAGE_TYPES=["image/jpeg","image/png","image/webp"]
TEMP_UPLOAD_DIR=./temp_uploads
DELETE_TEMP_IMAGES_AFTER_PROCESSING=True
